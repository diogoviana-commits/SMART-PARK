# Variaveis da API. Na Vercel, ficam em Settings > Environment Variables.
# Em desenvolvimento nenhuma e obrigatoria: sem DATABASE_URL, `npm run dev`
# usa um PostgreSQL embutido (PGlite) gravado em .dados-locais/.

# Banco PostgreSQL (Neon). Use a conexao SEM pooling (endereco sem "-pooler").
DATABASE_URL=

# Segredo que assina a sessao (JWT), com 32 caracteres ou mais.
# Obrigatorio em producao e nas previas: sem ele a API se recusa a subir.
SMARTPARK_JWT_SECRET=

# Senha da conta admin@smartpark.uscs, criada por `npm run migrar` se ainda
# nao existir. Sem ela, nenhuma conta de administracao e criada.
SMARTPARK_ADMIN_SENHA=

# Endereco publico do site, usado nos links enviados por e-mail e na volta do
# login com Google. Na Vercel, sem ela, vale o dominio de producao do projeto.
# SMARTPARK_URL_SITE=https://smart-park-eight-puce.vercel.app

# Envio de e-mail (confirmacao de cadastro e recuperacao de senha), pela Resend
# (resend.com). Sem as duas, "Esqueci minha senha" nao aparece no site publicado.
# O remetente precisa ser de um dominio verificado na Resend.
# SMARTPARK_EMAIL_CHAVE=
# SMARTPARK_EMAIL_REMETENTE=Smart Park <nao-responda@seu-dominio.com.br>

# Login com Google: cliente OAuth "Aplicativo da Web" no Google Cloud, com a URI
# de redirecionamento  <endereco do site>/api/usuarios/google/retorno
# Sem as duas, o botao "Continuar com Google" nao aparece.
# SMARTPARK_GOOGLE_ID=
# SMARTPARK_GOOGLE_SEGREDO=

# Opcionais (valores padrao entre parenteses)
# SMARTPARK_SESSAO_MINUTOS=120
# SMARTPARK_LOGIN_MAX_TENTATIVAS=5
# SMARTPARK_LOGIN_BLOQUEIO_MINUTOS=15
