# Variaveis da API. Na Vercel, ficam em Settings > Environment Variables.
# Em desenvolvimento nenhuma e obrigatoria: sem DATABASE_URL, `npm run dev`
# usa um PostgreSQL embutido (PGlite) gravado em .dados-locais/.

# Banco PostgreSQL (Neon). Use a conexao SEM pooling (endereco sem "-pooler").
DATABASE_URL=

# Segredo que assina a sessao (JWT), com 32 caracteres ou mais.
# Obrigatorio em producao e nas previas: sem ele a API se recusa a subir.
SMARTPARK_JWT_SECRET=

# Senha da conta admin@smartpark.uscs, criada por `npm run migrar` se ainda
# nao existir. Sem ela, nenhuma conta de administracao e criada.
SMARTPARK_ADMIN_SENHA=

# Opcionais (valores padrao entre parenteses)
# SMARTPARK_SESSAO_MINUTOS=120
# SMARTPARK_LOGIN_MAX_TENTATIVAS=5
# SMARTPARK_LOGIN_BLOQUEIO_MINUTOS=15
